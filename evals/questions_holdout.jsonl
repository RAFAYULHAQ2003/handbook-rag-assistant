{"id": "h-fut-01", "category": "future", "question": "We are adopting a child in December 2026. How long is secondary caregiver leave?", "expect": "answer", "expected_doc_ids": ["hr-parental-leave-policy"], "must_include": [["12 weeks", "twelve weeks"]], "reference_date": "2026-11-17", "notes": "Adoption before 2027-01-01, so the 2024 policy applies."}
{"id": "h-dep-01", "category": "deprecated", "question": "Is one approving review enough before I deploy a change?", "expect": "answer", "expected_doc_ids": ["eng-deploy-runbook"], "must_include": [["2 approving", "two approving", "2 reviews", "two reviews", "2 approvals", "two approvals"]], "notes": "Deprecated 2023 runbook says one review; current runbook and code review guidelines say two."}
{"id": "h-multi-01", "category": "multi_doc", "question": "I'm an L2 going to New York. What are my hotel cap and per-diem?", "expect": "answer", "expected_doc_ids": ["hr-travel-policy", "fin-per-diem-table"], "must_include": [["$275", "275"], ["$80", "80"]]}
{"id": "h-multi-02", "category": "multi_doc", "question": "I'm on the Platform team and my laptop broke. Who approves the replacement?", "expect": "answer", "expected_doc_ids": ["it-laptop-policy", "team-platform"], "must_include": [["Maya Brooks"]]}
{"id": "h-date-01", "category": "date", "question": "Is there a deploy freeze on December 15, 2026?", "expect": "answer", "expected_doc_ids": ["eng-deploy-runbook", "eng-release-calendar"], "must_include": [["freeze"], ["2026.24", "December 17", "2026-12-17"]], "reference_date": "2026-11-17", "notes": "Release 2026.24 on 2026-12-17; freeze starts 2026-12-14."}
