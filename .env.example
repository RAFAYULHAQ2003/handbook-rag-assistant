# Copy to .env and fill in. Never commit .env.
# Local development: debug on, throwaway key. In production set DJANGO_DEBUG=0 and a long random key.
# Make keys with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# (no "$" in values: docker compose would treat it as a variable)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Date used to decide which policies are in force (YYYY-MM-DD). Empty = today in COMPANY_TIMEZONE.
REFERENCE_DATE=
COMPANY_TIMEZONE=America/Chicago

# Model provider settings (added once the provider is chosen)

# Search. Mode: hybrid (default), bm25 or dense. Falls back to bm25 if the model cannot load.
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where downloaded models are kept (default: .cache/models in the project)
MODEL_CACHE_DIR=

# Answer model: any OpenAI-compatible API. All three are required; there are no built-in defaults.
# NVIDIA (active): key from build.nvidia.com
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Provider-specific request fields (JSON). NVIDIA: "thinking" on measured 0.959 vs 0.918 off on the dev set (slower: ~8s vs ~3s).
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": true}}
# OpenRouter instead: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=anthropic/claude-haiku-5.5,
# an OpenRouter key in LLM_API_KEY, and LLM_EXTRA_BODY empty.
# Backup model, used only when the main one is overloaded, rate-limited or too slow (same key and URL).
# Measured on the dev set: 0.897 (main model 0.959), refusals and injections 100%. Empty = no backup.
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_FALLBACK_EXTRA_BODY=
# If the main model hasn't answered after this many seconds, also ask the backup and take the first answer
# (0 = only use the backup after the main model fails). Paid providers may bill both calls.
LLM_HEDGE_AFTER_SECONDS=12
# Stop all paid model calls once this much has been spent in one process (empty = no cap).
# Only enforced when the provider reports cost (OpenRouter does; NVIDIA's free tier does not).
LLM_MAX_COST_USD=5

# Web answers: per-attempt timeout, retries, and a hard limit on the total wait (seconds; 0 = no limit).
# A slow or busy free tier then gives a clear "try again" instead of a page that hangs. Evals use their own, longer limits.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_DEADLINE_SECONDS=90
# Questions allowed per visitor address per minute (protects the provider's quota; 0 = no limit)
ASK_RATE_LIMIT_PER_MIN=20

# Uploaded documents ("Upload a document" on the page). Stored apart from the handbook, in media/uploads/
# by default; they are searchable at once, cited like any document, and always marked as not official.
# UPLOAD_DIR=
UPLOAD_MAX_MB=5
UPLOAD_MAX_DOCUMENTS=50
UPLOAD_RATE_LIMIT_PER_MIN=10

# Vector store for meaning search: chroma (default; a ChromaDB server) or memory (no server, used by tests).
# docker compose sets these itself. Running locally without compose: `docker compose up -d chroma`
# (published on 127.0.0.1:8001), or VECTOR_STORE=memory.
VECTOR_STORE=chroma
CHROMA_URL=http://localhost:8001

# Server only (docker compose --profile https up -d):
# DOMAIN=203-0-113-7.sslip.io          # your server's IP with dashes + .sslip.io, or your own domain
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=203-0-113-7.sslip.io
# DJANGO_CSRF_TRUSTED_ORIGINS=https://203-0-113-7.sslip.io
# DJANGO_HTTPS=1                       # HTTPS redirect, secure cookies, HSTS (DJANGO_HSTS_SECONDS, default 1 day)
# TRUST_PROXY=1                        # rate limits use the visitor address Caddy passes on
# WEB_PORT=127.0.0.1:8000              # keep the app itself off the public internet
